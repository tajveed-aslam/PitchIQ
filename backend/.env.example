# Copy to .env (never commit .env).
SECRET_KEY=change-me-to-a-long-random-string
# Local: SQLite file. Production: the Neon connection string (postgresql://...).
DATABASE_URL=sqlite:///./pitchiq.db
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3100
# Empty = run the analysis inside the API process (needs the analysis packages from the repo root .venv).
WORKER_URL=
WORKER_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
